{
  "expo": {
    "name": "ECG Reader",
    "slug": "ecg-reader-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ecgreader.app"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "The app needs the camera to photograph the ECG exam.",
          "photosPermission": "The app needs access to your photos to upload the ECG exam."
        }
      ]
    ],
    "android": {
      "package": "com.ecgreader.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    }
  }
}
